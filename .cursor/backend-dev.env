# Environment variables for running the Spring Boot backend locally (on the host)
# against the docker-compose Oracle XE + MinIO services. Dummy dev-only values.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
SPRING_DATASOURCE_USERNAME=reviewapp
SPRING_DATASOURCE_PASSWORD=reviewapp_pw

MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password12
MINIO_BUCKET=review-bucket

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Placeholder referenced by application.properties for the mail account password.
your_app_password_here=dummy_mail_pw
