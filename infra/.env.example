# Before deploy, change CORS_ALLOWED_ORIGINS and REACT_APP_API_BASE_URL to public addresses.

# Docker Compose BE to DB (Oracle, default: XEPDB1 for XE)
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//{db_service_name}:1521/XEPDB1
SPRING_DATASOURCE_USERNAME=oracle_username
SPRING_DATASOURCE_PASSWORD=oracle_password

# MinIO endpoint used by the backend (single client on main)
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_BUCKET=minio_bucket

# Browser to FE/BE
CORS_ALLOWED_ORIGINS=http://localhost:3000
REACT_APP_API_BASE_URL=http://localhost:8080

# For local development
# SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
# MINIO_URL=http://localhost:9000
