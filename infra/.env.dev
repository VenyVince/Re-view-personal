# Local development env for docker-compose infra (Oracle XE + MinIO).
# Dummy dev-only credentials. Copied to infra/.env by .cursor/dev-start.sh.
# For real deployments, replace all values (see infra/.env.example).

# Oracle XE (gvenzl/oracle-xe) init
ORACLE_PASSWORD=oracle_password
APP_USER=reviewapp
APP_USER_PASSWORD=reviewapp_pw

# Spring datasource (BE container -> Oracle service on the compose network)
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//oracle-db:1521/XEPDB1
SPRING_DATASOURCE_USERNAME=reviewapp
SPRING_DATASOURCE_PASSWORD=reviewapp_pw

# MinIO
MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password12
MINIO_BUCKET=review-bucket

# CORS / FE
CORS_ALLOWED_ORIGINS=http://localhost:3000
REACT_APP_API_BASE_URL=http://localhost:8080
