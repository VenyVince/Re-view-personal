# Copy this file to infra/.env.test and replace the passwords.
# infra/.env.test is gitignored. Do not point these values at port 1521 or service XEPDB1.
#
# The Oracle container reads ORACLE_PASSWORD and APP_USER_PASSWORD.
# Maven and the test profile read TEST_DATASOURCE_URL, TEST_DATASOURCE_USERNAME,
# and TEST_DATASOURCE_PASSWORD. APP_USER is fixed to REVIEW_TEST by docker-compose.yml.

ORACLE_PASSWORD=change-me-oracle-admin
APP_USER_PASSWORD=change-me-review-test

TEST_DATASOURCE_URL=jdbc:oracle:thin:@//127.0.0.1:1522/REVIEWTEST
TEST_DATASOURCE_USERNAME=REVIEW_TEST
TEST_DATASOURCE_PASSWORD=change-me-review-test
